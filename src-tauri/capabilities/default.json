{
  "$schema": "../gen/schemas/desktop-capability.json",
  "identifier": "default",
  "description": "default capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute", 
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "args": true,
          "sidecar": true,
          "name": "binaries/famos_engine"
        }
      ]
    },
    "dialog:default",
    "opener:default"
  ]
}